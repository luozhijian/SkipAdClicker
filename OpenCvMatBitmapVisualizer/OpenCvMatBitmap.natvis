<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <UIVisualizer ServiceId="{73D1AA4A-926B-41A9-9E54-D18FF81C6B22}" Id="1" MenuName="OpenCV cv::Mat Bitmap" />

  <Type Name="cv::Mat" Priority="High">
    <UIVisualizer ServiceId="{73D1AA4A-926B-41A9-9E54-D18FF81C6B22}" Id="1" />
  </Type>

  <Type Name="cv::Mat" Priority="Medium">
    <DisplayString Condition="data == 0 || rows == 0 || cols == 0">empty cv::Mat</DisplayString>
    <DisplayString>{rows}x{cols}, channels={((flags &amp; 0x0FF8) >> 3) + 1}, depth={flags &amp; 7}, step={step.p[0]} bytes</DisplayString>
    <Expand>
      <Item Name="width">cols</Item>
      <Item Name="height">rows</Item>
      <Item Name="channels">((flags &amp; 0x0FF8) >> 3) + 1</Item>
      <Item Name="depth">flags &amp; 7</Item>
      <Item Name="type">flags &amp; 0x0FFF</Item>
      <Item Name="is continuous">((flags &amp; (1 &lt;&lt; 14)) != 0)</Item>
      <Item Name="is submatrix">((flags &amp; (1 &lt;&lt; 15)) != 0)</Item>
      <Item Name="row stride bytes">step.p[0]</Item>
      <Item Name="data">data</Item>
    </Expand>
  </Type>

  <Type Name="cv::Mat_&lt;*&gt;" Priority="High">
    <UIVisualizer ServiceId="{73D1AA4A-926B-41A9-9E54-D18FF81C6B22}" Id="1" />
  </Type>
</AutoVisualizer>
